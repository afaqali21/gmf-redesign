# Copy to .env.local (development) or add to the hosting provider's environment settings.
# Never commit real passwords.

# --- Where enquiries are delivered -------------------------------------------------------
# Quote (/booking/), contact (/contact/) and blog-comment forms all email this address.
# Default: info@globalmarketingfirm.co.uk. Separate several addresses with commas.
ENQUIRY_TO=info@globalmarketingfirm.co.uk

# --- Sending through the info@ mailbox (SMTP) ------------------------------------------------
# The info@ mailbox is hosted on GMF's cPanel server (the one behind webmail). Checked 2026-11-26:
# mail.globalmarketingfirm.co.uk:465 has a valid SSL certificate for *.globalmarketingfirm.co.uk.
# Same details as cPanel > Email Accounts > Connect Devices > "Secure SSL/TLS Settings".
SMTP_HOST=mail.globalmarketingfirm.co.uk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@globalmarketingfirm.co.uk
# The password you use to log in to webmail for info@. Never commit it.
# Wrap it in single quotes: an unquoted # cuts the value off (it starts a comment) and $ is expanded.
SMTP_PASS=''
